+        }
+
+        private int size() {
+            return scopedBuffers.length;
+        }
+
+        @Override
+        public void close() {
+            for (ScopedBytes bytes : scopedBuffers) {
+                if (bytes != null) {
+                    bytes.close();
+                }
+            }
+            UnmanagedMemory.free(ioVec);
+        }
+    }
